DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

JWT_SECRET=(터미널에서 'openssl rand -base64 32' 실행 결과)

PUBLIC_DATA_API_KEY=your_public_data_api_key

TMDB_API_KEY=your_tmdb_api_key
TMDB_ACCESS_TOKEN=your_tmdb_access_token

KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# 네이버 검색 API(이미지) — 장소 사진의 마지막 수단.
# 카카오 로컬 API 에는 사진 필드가 없어서, 카카오로 보충한 식당·카페 사진은 여기서만 온다.
# developers.naver.com > 애플리케이션 등록 > "검색" API 추가 (무료, 하루 25,000건).
# 비워 두면 사진 없이 넘어갈 뿐, 앱은 정상 기동한다.
NAVER_SEARCH_CLIENT_ID=your_naver_search_client_id
NAVER_SEARCH_CLIENT_SECRET=your_naver_search_client_secret

MAIL_USERNAME=itda_official24@naver.com
MAIL_PASSWORD=

AWS_ACCESS_KEY=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key

ANTHROPIC_API_KEY=your_anthropic_api_key
