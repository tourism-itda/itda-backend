### =====================================================================
### 잇다(Itda) — 권승훈 파트 API 테스트 (v4 명세서 기준: No.25~32)
###   장소(place) 25~26 + 일정·플래너(itinerary) 27~32
### IntelliJ HTTP Client. 위에서부터 순서대로 실행하면 토큰/일정ID가 자동 저장됨.
###
### ⚠️ 경로에 /api 접두사가 붙습니다 (dev 브랜치 전체 규칙).
### ⚠️ 토큰은 안시현 파트의 로그인 API 로 받습니다. 아래 loginId/password 를
###    실제 가입해 둔 계정으로 바꿔서 쓰세요.
### 선행: docker compose -p itda up -d  (PostgreSQL)
### =====================================================================

@host = http://localhost:8080

### [사전] 로그인해서 JWT 받기 — user 1
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "loginId": "test1",
  "password": "test1234!"
}

> {% client.global.set("token", response.body.accessToken); %}

### =====================================================================
### 장소 (No.25~26)
### =====================================================================

### No.25 장소 상세 — 비로그인 (is_bookmarked=false, fee 없음)
GET {{host}}/api/places/1

### No.25 장소 상세 — 로그인 (place 1 은 user1 이 북마크 → is_bookmarked=true)
GET {{host}}/api/places/1
Authorization: Bearer {{token}}

### No.25 없는 장소 → 404 {code:NOT_FOUND}
GET {{host}}/api/places/9999

### No.26 대안 장소 — content 1, visit_order=1 다음 순위 중 place 1 제외
###   응답: { place: { ..., opening_hours, latitude, longitude } }
GET {{host}}/api/places/alternative?content_id=1&visit_order=1&exclude_place_id=1

### No.26 대안 장소 — exclude 없이 (content 2)
GET {{host}}/api/places/alternative?content_id=2&visit_order=2

### =====================================================================
### 일정·플래너 (No.27~32)
### =====================================================================

### No.27 추천 일정 (비저장) — content 1
###   응답: { content_id, content_title, region, slots:[{ visit_order, place:{ ..., to_next_* } }] }
GET {{host}}/api/itineraries/recommend?content_id=1

### No.28 일정 저장 — 응답 { itinerary_id }
POST {{host}}/api/itineraries
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content_id": 1,
  "title": "제주 2박 3일 여행",
  "travel_date": "2026-08-01",
  "region": "제주",
  "duration_label": "2박 3일",
  "places": [
    { "place_id": 1, "day_number": 1, "visit_order": 1, "status": "CONFIRMED" },
    { "place_id": 4, "day_number": 1, "visit_order": 2, "status": "PENDING", "memo": "땅콩 아이스크림" },
    { "place_id": 6, "day_number": 2, "visit_order": 1, "status": "PENDING" }
  ]
}

> {% client.global.set("itineraryId", response.body.itinerary_id); %}

### No.28 인증 없이 저장 → 401 {code:UNAUTHORIZED}
POST {{host}}/api/itineraries
Content-Type: application/json

{ "title": "무단 일정", "places": [ { "place_id": 1, "visit_order": 1 } ] }

### No.29 내 플래너 목록 (content_title, place_count, thumbnail_url 포함)
GET {{host}}/api/itineraries
Authorization: Bearer {{token}}

### No.30 저장 일정 상세 (places[]에 to_next_*, opening_hours 포함)
GET {{host}}/api/itineraries/{{itineraryId}}
Authorization: Bearer {{token}}

### No.30 남의 일정 접근 → 403 (다른 계정으로 로그인해 user1 일정 조회)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "loginId": "test2",
  "password": "test1234!"
}

> {% client.global.set("token2", response.body.accessToken); %}

###

# =====================================================================
# 하루 루트 (명세서 밖 신규 — 팀·프론트 합의 필요)
#   템플릿: 장소 → 식당(점심) → 카페 → 장소 → 식당(저녁) → 장소
#   식당·카페 칸은 비워서 내려가고, 사용자가 구간별 후보에서 골라 채운다.
# =====================================================================

### 콘텐츠의 촬영지 전체 목록 (직접선택 화면용)
GET {{host}}/api/contents/2/places

### 자동추천 — 촬영지를 안 고르면 서버가 3곳을 채운다
POST {{host}}/api/itineraries/route
Content-Type: application/json

{ "content_id": 2 }

> {% client.global.set("segStart", response.body.segments[0].start_place_id);
     client.global.set("segEnd",   response.body.segments[0].end_place_id); %}

### 직접선택 — 꼭 가고 싶은 촬영지를 최대 3개까지. 모자라면 서버가 채운다
POST {{host}}/api/itineraries/route
Content-Type: application/json

{
  "content_id": 2,
  "spot_place_ids": [8, 12],
  "allowance_meters": 2000
}

### 촬영지를 3개 넘게 보내면 앞에서부터 3개만 쓴다
POST {{host}}/api/itineraries/route
Content-Type: application/json

{ "content_id": 2, "spot_place_ids": [12, 8, 9, 13] }

### 구간 0 의 식당 후보 — 우회거리(동선 증가량) 오름차순
#   ⚠️ PUBLIC_DATA_API_KEY 가 없으면 candidates 는 빈 배열로 온다 (에러 아님)
GET {{host}}/api/itineraries/route/candidates?start_place_id={{segStart}}&end_place_id={{segEnd}}&slot_type=RESTAURANT&allowance_meters=2000

### 같은 구간의 카페 후보
GET {{host}}/api/itineraries/route/candidates?start_place_id={{segStart}}&end_place_id={{segEnd}}&slot_type=CAFE&allowance_meters=2000

### "다른 곳 추천" — 이미 본 후보를 제외하고 다시 조회
GET {{host}}/api/itineraries/route/candidates?start_place_id={{segStart}}&end_place_id={{segEnd}}&slot_type=RESTAURANT&exclude_external_ids=126508&exclude_external_ids=2649619

### 꼬리 구간 (end_place_id 없음) — 우회거리 대신 앵커에서 가까운 순
GET {{host}}/api/itineraries/route/candidates?start_place_id={{segStart}}&slot_type=RESTAURANT

### 촬영지는 후보 조회 대상이 아니다 → 400 {code:INVALID_REQUEST}
GET {{host}}/api/itineraries/route/candidates?start_place_id={{segStart}}&slot_type=SPOT

### 고른 후보를 place 로 확정하고 place_id 발급 (일정 저장 전 필수 단계)
#   ⚠️ external_id 는 위 후보 응답의 값으로 바꿔서 실행할 것
POST {{host}}/api/places/import
Content-Type: application/json

{ "external_id": "126508", "place_type": "RESTAURANT" }

> {% client.global.set("importedPlaceId", response.body.place_id); %}

###
GET {{host}}/api/itineraries/{{itineraryId}}
Authorization: Bearer {{token2}}

### No.31 일정 수정 — 제목/날짜 + places 전체 교체. 응답 { itinerary_id }
PATCH {{host}}/api/itineraries/{{itineraryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "제주 코스 (수정)",
  "travel_date": "2026-08-10",
  "places": [
    { "place_id": 5, "day_number": 1, "visit_order": 1, "status": "CONFIRMED" },
    { "place_id": 7, "day_number": 1, "visit_order": 2, "status": "PENDING" }
  ]
}

### No.32 일정 삭제 (soft delete) → { success: true }
DELETE {{host}}/api/itineraries/{{itineraryId}}
Authorization: Bearer {{token}}

### No.32 삭제 후 재조회 → 404 (soft delete 확인)
GET {{host}}/api/itineraries/{{itineraryId}}
Authorization: Bearer {{token}}
